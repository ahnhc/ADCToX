{"id": "MONDO:0019125", "kind": "everyday", "text": "귀랑 코 연골이 자꾸 붓고 아파요"}
{"id": "MONDO:0019125", "kind": "typo", "text": "재발성 다발연글염"}
{"id": "MONDO:0019125", "kind": "mixed", "text": "Relapsing polychondritis 의심"}
{"id": "MONDO:0019125", "kind": "spoken", "text": "귀 연골이 자꾸 부어서 재발성 다발연골염이래요"}
{"id": "MONDO:0005648", "kind": "everyday", "text": "심장 대동맥 판막이 제대로 안 닫혀요"}
{"id": "MONDO:0005648", "kind": "typo", "text": "대동백판막 폐쇄부전"}
{"id": "MONDO:0005648", "kind": "mixed", "text": "AR, 대동맥판막 폐쇄부전"}
{"id": "MONDO:0005648", "kind": "spoken", "text": "심초음파에서 대동맥판막이 덜 닫힌대요"}
{"id": "MONDO:0000468", "kind": "everyday", "text": "맥박이 너무 느리고 심장 전기 신호가 끊겨요"}
{"id": "MONDO:0000468", "kind": "typo", "text": "3도 방슬 차단"}
{"id": "MONDO:0000468", "kind": "mixed", "text": "3도 AV block"}
{"id": "MONDO:0000468", "kind": "spoken", "text": "심전도에서 3도 방실차단이라고 들었어요"}
{"id": "MONDO:0007407", "kind": "everyday", "text": "추우면 피부에 자반이 생기고 혈관이 붓는 병"}
{"id": "MONDO:0007407", "kind": "typo", "text": "한랭글로블린혈증 혈관염"}
{"id": "MONDO:0007407", "kind": "mixed", "text": "Cryoglobulinemia 혈관염"}
{"id": "MONDO:0007407", "kind": "spoken", "text": "피검사에서 한랭글로불린이 나와서 혈관염이래요"}
{"id": "MONDO:0019736", "kind": "everyday", "text": "신장 사구체에 단백 찌꺼기가 쌓이는 드문 신장병"}
{"id": "MONDO:0019736", "kind": "typo", "text": "치밀침작병"}
{"id": "MONDO:0019736", "kind": "mixed", "text": "DDD(치밀침착병)"}
{"id": "MONDO:0019736", "kind": "spoken", "text": "신장 조직검사에서 치밀침착병이라고 했어요"}
{"id": "MONDO:0003060", "kind": "everyday", "text": "간에서 쓸개즙 나가는 관에 생긴 암"}
{"id": "MONDO:0003060", "kind": "typo", "text": "담두암"}
{"id": "MONDO:0003060", "kind": "mixed", "text": "BTC(담도암) 진단"}
{"id": "MONDO:0003060", "kind": "spoken", "text": "쓸개즙 길에 암이 생겨서 담도암 진단받았어요"}
{"id": "MONDO:0002457", "kind": "everyday", "text": "태어날 때부터 광대뼈가 작고 귀 모양이 달라요"}
{"id": "MONDO:0002457", "kind": "typo", "text": "트리처 콜린즈 증후군"}
{"id": "MONDO:0002457", "kind": "mixed", "text": "Treacher Collins 증후군"}
{"id": "MONDO:0002457", "kind": "spoken", "text": "아이가 태어날 때부터 얼굴뼈가 작아서 트리처 콜린스래요"}
{"id": "MONDO:0005976", "kind": "everyday", "text": "성관계로 옮는 균 때문에 생기는 성병"}
{"id": "MONDO:0005976", "kind": "typo", "text": "메독"}
{"id": "MONDO:0005976", "kind": "mixed", "text": "Syphilis(매독) 의심"}
{"id": "MONDO:0005976", "kind": "spoken", "text": "성병 검사에서 매독 양성이 나와서 치료받았어요"}
{"id": "MONDO:0019186", "kind": "everyday", "text": "가축 근처에서 먼지 마시고 고열 나는 병"}
{"id": "MONDO:0019186", "kind": "typo", "text": "Q얼"}
{"id": "MONDO:0019186", "kind": "mixed", "text": "Q-fever 의심"}
{"id": "MONDO:0019186", "kind": "spoken", "text": "농장 다녀온 뒤 열이 계속 나서 Q열 검사했어요"}
{"id": "MONDO:0004664", "kind": "everyday", "text": "배 속에 기생충이 살아서 생긴 병"}
{"id": "MONDO:0004664", "kind": "typo", "text": "연충중"}
{"id": "MONDO:0004664", "kind": "mixed", "text": "Helminthiasis(연충증)"}
{"id": "MONDO:0004664", "kind": "spoken", "text": "대변검사에서 기생충 알이 나와서 연충증이래요"}
{"id": "MONDO:0021203", "kind": "everyday", "text": "귀에 물이 차서 먹먹하고 소리가 잘 안 들려요"}
{"id": "MONDO:0021203", "kind": "typo", "text": "삼출성 증이염"}
{"id": "MONDO:0021203", "kind": "mixed", "text": "SOM, 삼출성 중이염"}
{"id": "MONDO:0021203", "kind": "spoken", "text": "귀에 물이 고여 있어서 삼출성 중이염이래요"}
{"id": "MONDO:0006042", "kind": "everyday", "text": "결핵균 때문에 뇌를 싸는 막에 염증이 생겼어요"}
{"id": "MONDO:0006042", "kind": "typo", "text": "결핵성 수맥염"}
{"id": "MONDO:0006042", "kind": "mixed", "text": "TBM(결핵성 수막염)"}
{"id": "MONDO:0006042", "kind": "spoken", "text": "뇌척수액 검사에서 결핵성 수막염 의심된다고 했어요"}
{"id": "MONDO:0005119", "kind": "everyday", "text": "가죽이나 가축 다루다 옮는 균 때문에 생기는 병"}
{"id": "MONDO:0005119", "kind": "typo", "text": "탄져"}
{"id": "MONDO:0005119", "kind": "mixed", "text": "Anthrax 탄저"}
{"id": "MONDO:0005119", "kind": "spoken", "text": "목장 일하고 나서 탄저 감염이 의심된대요"}
{"id": "MONDO:0001371", "kind": "everyday", "text": "먹는 게 부족해서 살이 빠지고 기운이 없어요"}
{"id": "MONDO:0001371", "kind": "typo", "text": "단백질-에너지 영양실죠"}
{"id": "MONDO:0001371", "kind": "mixed", "text": "PEM, 단백질-에너지 영양실조"}
{"id": "MONDO:0001371", "kind": "spoken", "text": "식사를 거의 못 하셔서 영양실조 상태래요"}
