{"id": "MONDO:0020686", "kind": "everyday", "text": "편도가 부어서 목이 너무 아파요"}
{"id": "MONDO:0020686", "kind": "typo", "text": "급성 편도엄"}
{"id": "MONDO:0020686", "kind": "mixed", "text": "Acute tonsillitis 의증, 편도염"}
{"id": "MONDO:0020686", "kind": "spoken", "text": "목이 붓고 열이 나서 편도염이라고 하더라고요."}
{"id": "MONDO:0019719", "kind": "everyday", "text": "태어날 때부터 콩팥이랑 소변길에 기형이 있대요"}
{"id": "MONDO:0019719", "kind": "typo", "text": "선천선 신장 및 요로 기형"}
{"id": "MONDO:0019719", "kind": "mixed", "text": "CAKUT 진단, 신장요로 기형 추적관찰"}
{"id": "MONDO:0019719", "kind": "spoken", "text": "태어날 때부터 신장이랑 요로에 기형이 있어서 계속 봐요."}
{"id": "MONDO:0004496", "kind": "everyday", "text": "심장 근육에 염증이 생겼대요"}
{"id": "MONDO:0004496", "kind": "typo", "text": "심근엄"}
{"id": "MONDO:0004496", "kind": "mixed", "text": "myocarditis 의심, 심근염 r/o"}
{"id": "MONDO:0004496", "kind": "spoken", "text": "감기 앓고 나서 심장 근육에 염증이 생겼대요."}
{"id": "MONDO:0008533", "kind": "everyday", "text": "이가 원래보다 하나 더 나 있어요"}
{"id": "MONDO:0008533", "kind": "typo", "text": "과익치"}
{"id": "MONDO:0008533", "kind": "mixed", "text": "Supernumerary 치아, 과잉치 의심"}
{"id": "MONDO:0008533", "kind": "spoken", "text": "치과에서 이가 하나 더 있다고 엑스레이 찍었어요."}
{"id": "MONDO:0006823", "kind": "everyday", "text": "남자인데 염색체가 하나 더 있는 병이래요"}
{"id": "MONDO:0006823", "kind": "typo", "text": "클라인펠더 증후군"}
{"id": "MONDO:0006823", "kind": "mixed", "text": "47,XXY 클라인펠터 (KS)"}
{"id": "MONDO:0006823", "kind": "spoken", "text": "남자 염색체가 XXY라서 클라인펠터래요."}
{"id": "MONDO:0005672", "kind": "everyday", "text": "흙에 있는 곰팡이 균을 마셔서 생긴 병이래요"}
{"id": "MONDO:0005672", "kind": "typo", "text": "분야균증"}
{"id": "MONDO:0005672", "kind": "mixed", "text": "Blasto 감염 의심, 분아균증"}
{"id": "MONDO:0005672", "kind": "spoken", "text": "흙에서 나는 곰팡이 균을 들이마셔서 폐가 아프대요."}
{"id": "MONDO:0000628", "kind": "everyday", "text": "뇌척수에 생긴 양성 혹이래요"}
{"id": "MONDO:0000628", "kind": "typo", "text": "중추신경계 양성 신셍물"}
{"id": "MONDO:0000628", "kind": "mixed", "text": "CNS benign tumor 의심"}
{"id": "MONDO:0000628", "kind": "spoken", "text": "MRI에서 뇌척수 쪽에 양성 종양이 있대요."}
{"id": "MONDO:0018087", "kind": "everyday", "text": "바이러스 때문에 열나고 피가 나는 병이래요"}
{"id": "MONDO:0018087", "kind": "typo", "text": "바이러스싱 출혈열"}
{"id": "MONDO:0018087", "kind": "mixed", "text": "VHF 의심, 바이러스성 출혈열"}
{"id": "MONDO:0018087", "kind": "spoken", "text": "해외 다녀와서 고열이랑 출혈이 있어 출혈열 검사했어요."}
{"id": "MONDO:0006009", "kind": "everyday", "text": "바이러스가 뇌까지 가서 뇌가 부었대요"}
{"id": "MONDO:0006009", "kind": "typo", "text": "바이러스성 뇌엽"}
{"id": "MONDO:0006009", "kind": "mixed", "text": "viral 뇌염 r/o"}
{"id": "MONDO:0006009", "kind": "spoken", "text": "바이러스 때문에 뇌염이 왔다고 하더라고요."}
{"id": "MONDO:0018310", "kind": "everyday", "text": "뼈랑 피부에 이상한 세포가 쌓이는 희귀병이래요"}
{"id": "MONDO:0018310", "kind": "typo", "text": "랑게르한츠세포 조직구증"}
{"id": "MONDO:0018310", "kind": "mixed", "text": "LCH 의심, 랑게르한스 세포증"}
{"id": "MONDO:0018310", "kind": "spoken", "text": "뼈에 혹 같은 게 생겨서 조직검사했더니 랑게르한스 세포증이래요."}
{"id": "MONDO:0700081", "kind": "everyday", "text": "태어나자마자 숨을 잘 못 쉬었대요"}
{"id": "MONDO:0700081", "kind": "typo", "text": "신생야 호흡곤란 증후군"}
{"id": "MONDO:0700081", "kind": "mixed", "text": "신생아 RDS, 표면활성제 투여"}
{"id": "MONDO:0700081", "kind": "spoken", "text": "미숙아로 태어나서 숨쉬기 힘들어 인큐베이터 들어갔어요."}
{"id": "MONDO:0004471", "kind": "everyday", "text": "무릎이 세균 때문에 빨갛게 붓고 열이 나요"}
{"id": "MONDO:0004471", "kind": "typo", "text": "세군성 관절염"}
{"id": "MONDO:0004471", "kind": "mixed", "text": "Septic 관절염 r/o"}
{"id": "MONDO:0004471", "kind": "spoken", "text": "무릎이 갑자기 붓고 열이 나서 관절에 균이 들어갔대요."}
{"id": "MONDO:0008015", "kind": "everyday", "text": "차만 타면 속이 울렁거리고 토해요"}
{"id": "MONDO:0008015", "kind": "typo", "text": "멀민"}
{"id": "MONDO:0008015", "kind": "mixed", "text": "motion sickness 있음, 멀미약 복용"}
{"id": "MONDO:0008015", "kind": "spoken", "text": "배 타면 어지럽고 토할 것 같아서 멀미약 먹어요."}
{"id": "MONDO:0005705", "kind": "everyday", "text": "민물고기 회 먹고 간에 기생충 생겼대요"}
{"id": "MONDO:0005705", "kind": "typo", "text": "간흡총증"}
{"id": "MONDO:0005705", "kind": "mixed", "text": "Clonorchis 감염 의심 (간흡충)"}
{"id": "MONDO:0005705", "kind": "spoken", "text": "민물고기 날로 먹고 나서 간에 흡충이 있대요."}
{"id": "MONDO:0001067", "kind": "everyday", "text": "열대 지방 다녀와서 피부에 생긴 감염이래요"}
{"id": "MONDO:0001067", "kind": "typo", "text": "조기 프람배시아"}
{"id": "MONDO:0001067", "kind": "mixed", "text": "yaws 초기 (프람베시아)"}
{"id": "MONDO:0001067", "kind": "spoken", "text": "동남아 여행 후 피부에 돌기가 생겨서 프람베시아 초기래요."}
{"id": "MONDO:0018646", "kind": "everyday", "text": "간의 쓸개즙 길이 굳어서 막히는 병이래요"}
{"id": "MONDO:0018646", "kind": "typo", "text": "경화싱 담관염"}
{"id": "MONDO:0018646", "kind": "mixed", "text": "sclerosing cholangitis 의심, 담관 협착"}
{"id": "MONDO:0018646", "kind": "spoken", "text": "대장염 있는데 간 담관이 좁아져서 경화성 담관염이래요."}
{"id": "MONDO:0004872", "kind": "everyday", "text": "항문에 덩어리가 생겨서 피가 나요"}
{"id": "MONDO:0004872", "kind": "typo", "text": "지핵"}
{"id": "MONDO:0004872", "kind": "mixed", "text": "Hemorrhoid 의심, 치핵 수술 예정"}
{"id": "MONDO:0004872", "kind": "spoken", "text": "대변볼 때 피가 나서 항문 검사했더니 치핵이래요."}
{"id": "MONDO:0001229", "kind": "everyday", "text": "작은창자에 주머니가 생겨서 염증이 났대요"}
{"id": "MONDO:0001229", "kind": "typo", "text": "소장 계실염"}
{"id": "MONDO:0001229", "kind": "mixed", "text": "small bowel diverticulitis 의심"}
{"id": "MONDO:0001229", "kind": "spoken", "text": "배가 아파서 CT 찍었더니 소장에 게실이 있고 염증이래요."}
{"id": "MONDO:0005894", "kind": "everyday", "text": "남미에서 옮은 곰팡이 감염이래요"}
{"id": "MONDO:0005894", "kind": "typo", "text": "파라콕시디오이테스진균증"}
{"id": "MONDO:0005894", "kind": "mixed", "text": "PCM 의심, Paracoccidioides 감염"}
{"id": "MONDO:0005894", "kind": "spoken", "text": "브라질 다녀온 뒤 폐랑 림프절이 부어서 진균 감염이래요."}
{"id": "MONDO:0006981", "kind": "everyday", "text": "심장 안쪽 막에 세균이 붙어서 염증이 생겼대요"}
{"id": "MONDO:0006981", "kind": "typo", "text": "아급성 셰균성 심내막염"}
{"id": "MONDO:0006981", "kind": "mixed", "text": "SBE 의심, 심내막염 r/o"}
{"id": "MONDO:0006981", "kind": "spoken", "text": "이가 안 좋아서 균이 피로 들어가 심장 판막에 붙었대요."}
