{"id": "MONDO:0008449", "kind": "everyday", "text": "척추갈림증이래요"}
{"id": "MONDO:0008449", "kind": "typo", "text": "이부척추"}
{"id": "MONDO:0008449", "kind": "mixed", "text": "spina bifida 이분척추 (SB)"}
{"id": "MONDO:0008449", "kind": "spoken", "text": "태어날 때부터 등뼈가 덜 닫혀 있었다고 들었어요."}
{"id": "MONDO:0002471", "kind": "everyday", "text": "어깨 활액낭이 부었대요"}
{"id": "MONDO:0002471", "kind": "typo", "text": "윤활주머니엽"}
{"id": "MONDO:0002471", "kind": "mixed", "text": "bursitis(윤활낭염) 의심"}
{"id": "MONDO:0002471", "kind": "spoken", "text": "무릎 앞이 부어서 관절 주머니에 염증이 있대요."}
{"id": "MONDO:0009693", "kind": "everyday", "text": "혈액암 중에 골수종이래요"}
{"id": "MONDO:0009693", "kind": "typo", "text": "형질세포 골수중"}
{"id": "MONDO:0009693", "kind": "mixed", "text": "MM 형질세포 골수종 의심"}
{"id": "MONDO:0009693", "kind": "spoken", "text": "소변에 단백이 나오고 뼈가 아파서 골수종 검사를 받았어요."}
{"id": "MONDO:0005324", "kind": "everyday", "text": "봄마다 재채기가 계속 나는 비염"}
{"id": "MONDO:0005324", "kind": "typo", "text": "게절성 알레르기 비염"}
{"id": "MONDO:0005324", "kind": "mixed", "text": "SAR 계절성 알레르기비염"}
{"id": "MONDO:0005324", "kind": "spoken", "text": "해마다 4월이면 코가 간지럽고 재채기가 나와요."}
{"id": "MONDO:0001718", "kind": "everyday", "text": "눈 흰자위에 염증이 생겼어요"}
{"id": "MONDO:0001718", "kind": "typo", "text": "공막엽"}
{"id": "MONDO:0001718", "kind": "mixed", "text": "scleritis(공막염) OD"}
{"id": "MONDO:0001718", "kind": "spoken", "text": "눈 흰자가 욱신거리고 아파서 안과에 갔더니 공막염이래요."}
{"id": "MONDO:0005649", "kind": "everyday", "text": "맹장염이래요, 수술해야 한대요"}
{"id": "MONDO:0005649", "kind": "typo", "text": "충수념"}
{"id": "MONDO:0005649", "kind": "mixed", "text": "appendicitis 충수염 r/o"}
{"id": "MONDO:0005649", "kind": "spoken", "text": "오른쪽 아랫배가 콕콕 쑤셔서 맹장 터질까 봐 걱정돼요."}
{"id": "MONDO:0024271", "kind": "everyday", "text": "장에 기생충이 살고 있대요"}
{"id": "MONDO:0024271", "kind": "typo", "text": "장 연층증"}
{"id": "MONDO:0024271", "kind": "mixed", "text": "장 helminthiasis 연충증"}
{"id": "MONDO:0024271", "kind": "spoken", "text": "대변검사에서 기생충 알이 나왔다고 해요."}
{"id": "MONDO:0003648", "kind": "everyday", "text": "귓속 막에 문제가 있대요"}
{"id": "MONDO:0003648", "kind": "typo", "text": "고말 질환"}
{"id": "MONDO:0003648", "kind": "mixed", "text": "고막 TM disorder 진단"}
{"id": "MONDO:0003648", "kind": "spoken", "text": "귀가 먹먹한데 진료에서 고막에 문제가 있다고 했어요."}
{"id": "MONDO:0001714", "kind": "everyday", "text": "비성병성 매독이래요"}
{"id": "MONDO:0001714", "kind": "typo", "text": "배젤"}
{"id": "MONDO:0001714", "kind": "mixed", "text": "bejel(베젤) 풍토성 매독"}
{"id": "MONDO:0001714", "kind": "spoken", "text": "피부에 궤양이 생겼고 매독 같은 풍토병이라고 하더라고요."}
{"id": "MONDO:0008410", "kind": "everyday", "text": "사춘기 때 등이 굽는 병이래요"}
{"id": "MONDO:0008410", "kind": "typo", "text": "쇼이어난병"}
{"id": "MONDO:0008410", "kind": "mixed", "text": "Scheuermann 병 척추 X-ray 소견"}
{"id": "MONDO:0008410", "kind": "spoken", "text": "중학생 때 등이 둥글게 굽어서 쇼이어만병인지 봐야 한대요."}
{"id": "MONDO:0005593", "kind": "everyday", "text": "잇몸 염증이 오래돼서 이가 흔들려요"}
{"id": "MONDO:0005593", "kind": "typo", "text": "만생 치주염"}
{"id": "MONDO:0005593", "kind": "mixed", "text": "만성 perio 치주염 치료 중"}
{"id": "MONDO:0005593", "kind": "spoken", "text": "잇몸에서 피가 자주 나고 이가 흔들려서 치료받고 있어요."}
{"id": "MONDO:0001703", "kind": "everyday", "text": "빨강이랑 초록을 잘 구별 못 해요"}
{"id": "MONDO:0001703", "kind": "typo", "text": "색갹 이상"}
{"id": "MONDO:0001703", "kind": "mixed", "text": "CVD 색각이상 확인"}
{"id": "MONDO:0001703", "kind": "spoken", "text": "운전면허 신체검사에서 색 구별이 안 된다고 나왔어요."}
{"id": "MONDO:0004715", "kind": "everyday", "text": "간암 0기라고 들었어요"}
{"id": "MONDO:0004715", "kind": "typo", "text": "간 상피내암중"}
{"id": "MONDO:0004715", "kind": "mixed", "text": "Liver CIS 간 상피내암"}
{"id": "MONDO:0004715", "kind": "spoken", "text": "검사에서 간에 아직 퍼지지 않은 암세포가 있다고 했어요."}
{"id": "MONDO:0006031", "kind": "everyday", "text": "축농증이 몇 달째 안 낫고 있어요"}
{"id": "MONDO:0006031", "kind": "typo", "text": "만성 비부비동엽"}
{"id": "MONDO:0006031", "kind": "mixed", "text": "CRS 만성 비부비동염"}
{"id": "MONDO:0006031", "kind": "spoken", "text": "코막힘과 누런 콧물이 몇 달째라서 만성 축농증이래요."}
{"id": "MONDO:0001514", "kind": "everyday", "text": "소변 길 쪽이 밖으로 나왔대요"}
{"id": "MONDO:0001514", "kind": "typo", "text": "요도 탈춘"}
{"id": "MONDO:0001514", "kind": "mixed", "text": "urethral prolapse(요도 탈출)"}
{"id": "MONDO:0001514", "kind": "spoken", "text": "요도 점막이 밖으로 나와 있다고 진료에서 들었어요."}
{"id": "MONDO:0001174", "kind": "everyday", "text": "눈 흰자 핏줄이 늘 빨개요"}
{"id": "MONDO:0001174", "kind": "typo", "text": "결막 혈관 질완"}
{"id": "MONDO:0001174", "kind": "mixed", "text": "결막 vascular 질환"}
{"id": "MONDO:0001174", "kind": "spoken", "text": "눈 흰자 쪽 혈관이 자꾸 빨갛게 보인다고 하더라고요."}
{"id": "MONDO:0016086", "kind": "everyday", "text": "어린애 발뼈가 괴사됐대요"}
{"id": "MONDO:0016086", "kind": "typo", "text": "쪽근골/중족골 골연골염"}
{"id": "MONDO:0016086", "kind": "mixed", "text": "Kohler 병 주상골"}
{"id": "MONDO:0016086", "kind": "spoken", "text": "아이가 걸을 때 발등이 아프다고 해서 주상골 검사를 받았어요."}
{"id": "MONDO:0020655", "kind": "everyday", "text": "어릴 때부터 척추가 굳는 병이래요"}
{"id": "MONDO:0020655", "kind": "typo", "text": "소아 강직성 척주염"}
{"id": "MONDO:0020655", "kind": "mixed", "text": "소아 AS 강직성 척추염"}
{"id": "MONDO:0020655", "kind": "spoken", "text": "어릴 때부터 허리가 뻣뻣하고 강직성 척추염이라고 해요."}
{"id": "MONDO:0004184", "kind": "everyday", "text": "소변 줄기가 가늘고 요도가 따가워요"}
{"id": "MONDO:0004184", "kind": "typo", "text": "요도 질횐"}
{"id": "MONDO:0004184", "kind": "mixed", "text": "urethra 질환 진단"}
{"id": "MONDO:0004184", "kind": "spoken", "text": "소변 볼 때 요도가 자꾸 아프다고 진료 받았어요."}
{"id": "MONDO:0006608", "kind": "everyday", "text": "두피에 비듬처럼 뜨고 가려워요"}
{"id": "MONDO:0006608", "kind": "typo", "text": "지누피부염"}
{"id": "MONDO:0006608", "kind": "mixed", "text": "SD 지루피부염 두피"}
{"id": "MONDO:0006608", "kind": "spoken", "text": "눈썹이랑 코 옆이 허물이 일고 가려워서 지루성 피부염이래요."}
