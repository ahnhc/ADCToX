{"id": "MONDO:0043303", "kind": "everyday", "text": "소리가 너무 크게 들려서 귀가 아프고 못 견뎌요"}
{"id": "MONDO:0043303", "kind": "typo", "text": "청가과민"}
{"id": "MONDO:0043303", "kind": "mixed", "text": "Hyperacusis 청각과민 소견"}
{"id": "MONDO:0043303", "kind": "spoken", "text": "요즘 작은 소리도 너무 크게 들려서 힘들다고 해요."}
{"id": "MONDO:0005724", "kind": "everyday", "text": "비둘기 배설물 때문에 걸리는 곰팡이 병이래요"}
{"id": "MONDO:0005724", "kind": "typo", "text": "크립토코쿠스즘"}
{"id": "MONDO:0005724", "kind": "mixed", "text": "Cryptococcus 감염 F/U 중"}
{"id": "MONDO:0005724", "kind": "spoken", "text": "비둘기 똥 때문에 곰팡이 감염이 생겼다고 하셨어요."}
{"id": "MONDO:0000301", "kind": "everyday", "text": "눈에 벌레 애벌레가 생겼다고 해요"}
{"id": "MONDO:0000301", "kind": "typo", "text": "안구 구데기증"}
{"id": "MONDO:0000301", "kind": "mixed", "text": "ophthalmomyiasis 안구 충증 의심"}
{"id": "MONDO:0000301", "kind": "spoken", "text": "양 털에서 나온 애벌레가 눈에 들어갔다고 해요."}
{"id": "MONDO:0006742", "kind": "everyday", "text": "요오드가 부족해서 목에 혹처럼 갑상선이 부었대요"}
{"id": "MONDO:0006742", "kind": "typo", "text": "풍토썽 갑상선종"}
{"id": "MONDO:0006742", "kind": "mixed", "text": "endemic 갑상선종 (요오드 결핍)"}
{"id": "MONDO:0006742", "kind": "spoken", "text": "요오드가 부족해서 갑상선이 커졌다고 하셨어요."}
{"id": "MONDO:0005808", "kind": "everyday", "text": "출산 때 엄마한테 옮은 아기 눈병이래요"}
{"id": "MONDO:0005808", "kind": "typo", "text": "봉입체 결막엮"}
{"id": "MONDO:0005808", "kind": "mixed", "text": "Chlamydia 결막염 (신생아)"}
{"id": "MONDO:0005808", "kind": "spoken", "text": "출생 직후 아기 눈이 부어서 클라미디아 검사했어요."}
{"id": "MONDO:0019345", "kind": "everyday", "text": "피 섞인 설사가 나서 이질 걸렸대요"}
{"id": "MONDO:0019345", "kind": "typo", "text": "세균성 이직"}
{"id": "MONDO:0019345", "kind": "mixed", "text": "Shigella 장염 (이질)"}
{"id": "MONDO:0019345", "kind": "spoken", "text": "피고름 섞인 설사가 나서 시겔라 균 나왔대요."}
{"id": "MONDO:0001860", "kind": "everyday", "text": "엽산이 모자라서 생긴 빈혈이래요"}
{"id": "MONDO:0001860", "kind": "typo", "text": "엽산결핍썽 빈헐"}
{"id": "MONDO:0001860", "kind": "mixed", "text": "Folate deficiency 빈혈"}
{"id": "MONDO:0001860", "kind": "spoken", "text": "엽산 수치가 낮아서 빈혈 진단 받았어요."}
{"id": "MONDO:0018921", "kind": "everyday", "text": "태아 때 뇌 기형이랑 콩팥 낭종이 같이 생기는 병"}
{"id": "MONDO:0018921", "kind": "typo", "text": "메켈 증후근"}
{"id": "MONDO:0018921", "kind": "mixed", "text": "Meckel 증후군 (뇌탈출 동반)"}
{"id": "MONDO:0018921", "kind": "spoken", "text": "태아 초음파에서 뇌탈출이 있어서 메켈 증후군 의심이래요."}
{"id": "MONDO:0015908", "kind": "everyday", "text": "발에 곰팡이 상처가 생겨서 딱지가 두꺼워졌어요"}
{"id": "MONDO:0015908", "kind": "typo", "text": "크로모진균즘"}
{"id": "MONDO:0015908", "kind": "mixed", "text": "Chromo 진균증 (피부)"}
{"id": "MONDO:0015908", "kind": "spoken", "text": "다리에 난 상처가 안 낫고 진균 감염이래요."}
{"id": "MONDO:0000827", "kind": "everyday", "text": "상한 달걀 먹고 장염 걸렸어요"}
{"id": "MONDO:0000827", "kind": "typo", "text": "살모넬라중"}
{"id": "MONDO:0000827", "kind": "mixed", "text": "Salmonella 장염 의심"}
{"id": "MONDO:0000827", "kind": "spoken", "text": "계란 먹고 복통이랑 설사가 나서 살모넬라 검사했어요."}
{"id": "MONDO:0001444", "kind": "everyday", "text": "중남미 벌레한테 물려서 걸리는 기생충병이래요"}
{"id": "MONDO:0001444", "kind": "typo", "text": "샤카스병"}
{"id": "MONDO:0001444", "kind": "mixed", "text": "Chagas 심근증 의심"}
{"id": "MONDO:0001444", "kind": "spoken", "text": "남미 다녀온 뒤 심장이 약해서 샤가스병 검사했어요."}
{"id": "MONDO:0005828", "kind": "everyday", "text": "임신 중에 날 치즈 먹고 걸린 세균 감염이래요"}
{"id": "MONDO:0005828", "kind": "typo", "text": "리스테리야증"}
{"id": "MONDO:0005828", "kind": "mixed", "text": "Listeria 감염 F/U 중"}
{"id": "MONDO:0005828", "kind": "spoken", "text": "임신 중 생치즈 먹고 리스테리아 감염이라고 하셨어요."}
{"id": "MONDO:0002738", "kind": "everyday", "text": "감기 끝나고 귀 안에 물이 차서 먹먹해요"}
{"id": "MONDO:0002738", "kind": "typo", "text": "급성 삼출썽 중이염"}
{"id": "MONDO:0002738", "kind": "mixed", "text": "급성 OME (삼출성)"}
{"id": "MONDO:0002738", "kind": "spoken", "text": "감기 끝나고 귀에 물이 고여서 고막 검사했어요."}
{"id": "MONDO:0007319", "kind": "everyday", "text": "관절에 칼슘 결정이 쌓이는 집안 내력 유전병이래요"}
{"id": "MONDO:0007319", "kind": "typo", "text": "연골석희화증 2"}
{"id": "MONDO:0007319", "kind": "mixed", "text": "familial CPPD 2형"}
{"id": "MONDO:0007319", "kind": "spoken", "text": "집안 내력으로 무릎 연골에 석회가 낀다고 해요."}
{"id": "MONDO:0018908", "kind": "everyday", "text": "림프절에 생기는 암인데 호지킨 말고 나머지 림프암"}
{"id": "MONDO:0018908", "kind": "typo", "text": "비호지킨 림프증"}
{"id": "MONDO:0018908", "kind": "mixed", "text": "NHL 림프종 R-CHOP 중"}
{"id": "MONDO:0018908", "kind": "spoken", "text": "비호지킨 림프종이라서 항암 시작한다고 하셨어요."}
{"id": "MONDO:0001252", "kind": "everyday", "text": "갑상선에 혹이 여러 개 생기고 호르몬이 너무 많이 나와요"}
{"id": "MONDO:0001252", "kind": "typo", "text": "독성 다결절썽 갑상선종"}
{"id": "MONDO:0001252", "kind": "mixed", "text": "Toxic MNG 갑상선종"}
{"id": "MONDO:0001252", "kind": "spoken", "text": "갑상선에 혹이 여러 개 있고 호르몬이 많이 나와서 약 먹어요."}
{"id": "MONDO:0006515", "kind": "everyday", "text": "갑자기 명치가 찢어지듯 아프고 토해요"}
{"id": "MONDO:0006515", "kind": "typo", "text": "급성 췌장엄"}
{"id": "MONDO:0006515", "kind": "mixed", "text": "Acute 췌장염 (AP) 의심"}
{"id": "MONDO:0006515", "kind": "spoken", "text": "명치 통증으로 응급실 갔는데 급성 췌장염이래요."}
{"id": "MONDO:0001921", "kind": "everyday", "text": "귀에서 오래된 고름이 계속 나고 고막 위쪽에 구멍이 있어요"}
{"id": "MONDO:0001921", "kind": "typo", "text": "만성 상고실-유양돔 질환"}
{"id": "MONDO:0001921", "kind": "mixed", "text": "Atticoantral 중이염 (만성)"}
{"id": "MONDO:0001921", "kind": "spoken", "text": "귀에서 고름이 계속 나고 고막 위쪽에 구멍이 있다고 하셨어요."}
{"id": "MONDO:0002164", "kind": "everyday", "text": "눈 안쪽에 염증이 한 군데 생겨서 그쪽이 안 보여요"}
{"id": "MONDO:0002164", "kind": "typo", "text": "국소 맥낙망막염"}
{"id": "MONDO:0002164", "kind": "mixed", "text": "focal 맥락망막염 (OD)"}
{"id": "MONDO:0002164", "kind": "spoken", "text": "오른쪽 눈 안쪽에 국소 염증이 있어서 맥락망막염이래요."}
{"id": "MONDO:0001422", "kind": "everyday", "text": "부신에서 알도스테론이 많이 나와서 혈압이 높고 칼륨이 낮아요"}
{"id": "MONDO:0001422", "kind": "typo", "text": "원발썽 알도스테론증"}
{"id": "MONDO:0001422", "kind": "mixed", "text": "Conn 증후군 의심 (원발성 알도)"}
{"id": "MONDO:0001422", "kind": "spoken", "text": "혈압약을 먹는데 칼륨이 낮아서 부신 검사 했어요."}
