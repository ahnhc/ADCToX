{"id": "MONDO:0005480", "kind": "everyday", "text": "옷 닿는 데마다 가렵고 빨갛게 부어요"}
{"id": "MONDO:0005480", "kind": "typo", "text": "접축피부염"}
{"id": "MONDO:0005480", "kind": "mixed", "text": "접촉성 피부염(contact derm) 의심"}
{"id": "MONDO:0005480", "kind": "spoken", "text": "화장품 바르고 얼굴이 빨갛게 부어서 접촉피부염이래요."}
{"id": "MONDO:0001935", "kind": "everyday", "text": "신경이 망가져서 관절이 찌그러졌대요"}
{"id": "MONDO:0001935", "kind": "typo", "text": "신경병성 관절병중"}
{"id": "MONDO:0001935", "kind": "mixed", "text": "샤르코 관절병증(Charcot joint)"}
{"id": "MONDO:0001935", "kind": "spoken", "text": "신경이 안 좋아서 무릎 관절이 변형됐대요."}
{"id": "MONDO:0024431", "kind": "everyday", "text": "간이 빌리루빈을 제대로 못 처리하는 병이래요"}
{"id": "MONDO:0024431", "kind": "typo", "text": "빌리루빈 대삭 질환"}
{"id": "MONDO:0024431", "kind": "mixed", "text": "bilirubin 대사이상 의심"}
{"id": "MONDO:0024431", "kind": "spoken", "text": "빌리루빈 수치가 계속 높아서 대사 쪽 문제래요."}
{"id": "MONDO:0001719", "kind": "everyday", "text": "성병균 때문에 무릎 주변이 붓고 아파요"}
{"id": "MONDO:0001719", "kind": "typo", "text": "임군성 점액낭염"}
{"id": "MONDO:0001719", "kind": "mixed", "text": "임균성 bursitis 의심"}
{"id": "MONDO:0001719", "kind": "spoken", "text": "임질균 감염으로 점액낭이 부었대요."}
{"id": "MONDO:0021032", "kind": "everyday", "text": "눈꺼풀에 물집 나고 대상포진 걸렸어요"}
{"id": "MONDO:0021032", "kind": "typo", "text": "눈꺼플 피부염을 동반한 대상포진"}
{"id": "MONDO:0021032", "kind": "mixed", "text": "HZO 눈꺼풀 대상포진"}
{"id": "MONDO:0021032", "kind": "spoken", "text": "눈 위쪽에 대상포진 올라와서 눈꺼풀이 붓대요."}
{"id": "MONDO:0002420", "kind": "everyday", "text": "자꾸 눈을 깜빡이고 목을 움찔거려요"}
{"id": "MONDO:0002420", "kind": "typo", "text": "틱 장에"}
{"id": "MONDO:0002420", "kind": "mixed", "text": "Tic 장애 의심"}
{"id": "MONDO:0002420", "kind": "spoken", "text": "아이가 계속 킁킁거리고 얼굴을 찡그려요, 틱 장애래요."}
{"id": "MONDO:0015898", "kind": "everyday", "text": "부신에서 남성호르몬이 많이 나오는 병이래요"}
{"id": "MONDO:0015898", "kind": "typo", "text": "부신성기 증후궁"}
{"id": "MONDO:0015898", "kind": "mixed", "text": "adrenogenital 증후군"}
{"id": "MONDO:0015898", "kind": "spoken", "text": "아기 때부터 부신 호르몬 이상이라 생식기 발달이 달랐대요."}
{"id": "MONDO:0005651", "kind": "everyday", "text": "쥐한테 옮는 피나는 열병이래요"}
{"id": "MONDO:0005651", "kind": "typo", "text": "아레나바이로스 출혈열"}
{"id": "MONDO:0005651", "kind": "mixed", "text": "arenavirus HF 출혈열"}
{"id": "MONDO:0005651", "kind": "spoken", "text": "아프리카 다녀와서 열이랑 출혈이 있어 아레나바이러스 검사했어요."}
{"id": "MONDO:0005821", "kind": "everyday", "text": "엄마한테 옮은 매독이 뒤늦게 나타났대요"}
{"id": "MONDO:0005821", "kind": "typo", "text": "후기 선천셩 매독"}
{"id": "MONDO:0005821", "kind": "mixed", "text": "late 선천성 syphilis"}
{"id": "MONDO:0005821", "kind": "spoken", "text": "아이가 두 살 넘어서 선천성 매독 증상이 나왔대요."}
{"id": "MONDO:0001369", "kind": "everyday", "text": "목소리가 몇 달째 쉬어 있고 잘 안 나와요"}
{"id": "MONDO:0001369", "kind": "typo", "text": "만성 후두념"}
{"id": "MONDO:0001369", "kind": "mixed", "text": "만성 laryngitis 후두염"}
{"id": "MONDO:0001369", "kind": "spoken", "text": "담배를 오래 피워서 목소리가 계속 쉬어 있대요."}
{"id": "MONDO:0002237", "kind": "everyday", "text": "목덜미에 고름 종기가 여러 개 뭉쳐 났어요"}
{"id": "MONDO:0002237", "kind": "typo", "text": "큰죵기"}
{"id": "MONDO:0002237", "kind": "mixed", "text": "carbuncle 종기 의심"}
{"id": "MONDO:0002237", "kind": "spoken", "text": "목 뒤에 종기가 뭉쳐서 크게 곪았어요, 열도 나요."}
{"id": "MONDO:0005099", "kind": "everyday", "text": "머리가 찢어질 듯 아프고 뇌에 피가 나서 쓰러졌어요"}
{"id": "MONDO:0005099", "kind": "typo", "text": "지쥬막하 출혈"}
{"id": "MONDO:0005099", "kind": "mixed", "text": "SAH 지주막하출혈"}
{"id": "MONDO:0005099", "kind": "spoken", "text": "CT에서 지주막하출혈 보인다고 하셨어요."}
{"id": "MONDO:0005502", "kind": "everyday", "text": "모기 물리고 나서 고열이랑 근육통이 심해요"}
{"id": "MONDO:0005502", "kind": "typo", "text": "덩기병"}
{"id": "MONDO:0005502", "kind": "mixed", "text": "뎅기(dengue) 의심 고열"}
{"id": "MONDO:0005502", "kind": "spoken", "text": "해외 다녀와서 뎅기병 검사 받았어요, 혈소판이 낮대요."}
{"id": "MONDO:0001127", "kind": "everyday", "text": "발목 안쪽 앞부분이 아프고 발등 올리기 힘들어요"}
{"id": "MONDO:0001127", "kind": "typo", "text": "경골근 건엽"}
{"id": "MONDO:0001127", "kind": "mixed", "text": "tibialis 건염"}
{"id": "MONDO:0001127", "kind": "spoken", "text": "발목 안쪽 힘줄이 부었어요, 경골근 건염이래요."}
{"id": "MONDO:0019168", "kind": "everyday", "text": "근육 속에 고름이 차서 붓고 열이 나요"}
{"id": "MONDO:0019168", "kind": "typo", "text": "화놈성 근염"}
{"id": "MONDO:0019168", "kind": "mixed", "text": "pyomyositis(PM) 화농성"}
{"id": "MONDO:0019168", "kind": "spoken", "text": "다리 근육이 퉁퉁 붓고 열나서 고름 찼대요."}
{"id": "MONDO:0006945", "kind": "everyday", "text": "콩팥으로 가는 혈관이 막혀서 혈압이 올랐대요"}
{"id": "MONDO:0006945", "kind": "typo", "text": "신동맥 페색"}
{"id": "MONDO:0006945", "kind": "mixed", "text": "신동맥 occlusion 의심"}
{"id": "MONDO:0006945", "kind": "spoken", "text": "CT에서 콩팥 동맥이 막혔다고 해서 혈압약 늘렸어요."}
{"id": "MONDO:0020601", "kind": "everyday", "text": "모기한테 물리고 나서 뇌염 걸렸대요"}
{"id": "MONDO:0020601", "kind": "typo", "text": "모기매개 바이로스뇌염"}
{"id": "MONDO:0020601", "kind": "mixed", "text": "mosquito-borne 뇌염"}
{"id": "MONDO:0020601", "kind": "spoken", "text": "모기 물리고 열, 두통이 심하더니 뇌염이래요."}
{"id": "MONDO:0000984", "kind": "everyday", "text": "어릴 때부터 빈혈이 심하고 피가 잘 안 만들어져요"}
{"id": "MONDO:0000984", "kind": "typo", "text": "지중애빈혈"}
{"id": "MONDO:0000984", "kind": "mixed", "text": "thalassemia 빈혈 검사"}
{"id": "MONDO:0000984", "kind": "spoken", "text": "지중해빈혈이라서 수혈을 주기적으로 받아요."}
{"id": "MONDO:0019355", "kind": "everyday", "text": "어른인데 열이 계속 나고 관절이 아프고 발진이 생겨요"}
{"id": "MONDO:0019355", "kind": "typo", "text": "성인 발병 스틸벙"}
{"id": "MONDO:0019355", "kind": "mixed", "text": "AOSD 스틸병"}
{"id": "MONDO:0019355", "kind": "spoken", "text": "열이 원인 모르게 오래 나서 AOSD 의심됐어요."}
{"id": "MONDO:0004621", "kind": "everyday", "text": "윗입술에 혹이 생겼는데 안 낫고 암이래요"}
{"id": "MONDO:0004621", "kind": "typo", "text": "윗입술압"}
{"id": "MONDO:0004621", "kind": "mixed", "text": "윗입술 Ca"}
{"id": "MONDO:0004621", "kind": "spoken", "text": "윗입술 상처가 두 달째 낫질 않아서 조직검사했더니 암이래요."}
