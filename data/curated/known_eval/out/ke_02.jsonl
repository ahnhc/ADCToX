{"id": "MONDO:0024268", "kind": "everyday", "text": "피부에 곰팡이가 옮아서 생긴 겉피부 감염"}
{"id": "MONDO:0024268", "kind": "typo", "text": "표재선 진균증"}
{"id": "MONDO:0024268", "kind": "mixed", "text": "표재성 mycosis"}
{"id": "MONDO:0024268", "kind": "spoken", "text": "피부 겉에 곰팡이 감염이 생겼다고 하네요."}
{"id": "MONDO:0006752", "kind": "everyday", "text": "돼지 다루다 손에 생긴 세균 감염"}
{"id": "MONDO:0006752", "kind": "typo", "text": "돼지단득균 감염증"}
{"id": "MONDO:0006752", "kind": "mixed", "text": "Erysipelothrix 감염증"}
{"id": "MONDO:0006752", "kind": "spoken", "text": "돼지 도축하다 손가락이 붓고 열이 났대요."}
{"id": "MONDO:0001339", "kind": "everyday", "text": "간으로 가는 큰 혈관에 피떡이 생긴 것"}
{"id": "MONDO:0001339", "kind": "typo", "text": "문백 혈전증"}
{"id": "MONDO:0001339", "kind": "mixed", "text": "portal vein 혈전증"}
{"id": "MONDO:0001339", "kind": "spoken", "text": "간 쪽 혈관에 피떡이 생겨서 피 묽게 하는 약 먹어요."}
{"id": "MONDO:0006805", "kind": "everyday", "text": "요즘 들어 가만히 있어도 가슴이 자주 아파요"}
{"id": "MONDO:0006805", "kind": "typo", "text": "중간 관상동맥 증후근"}
{"id": "MONDO:0006805", "kind": "mixed", "text": "intermediate coronary 증후군"}
{"id": "MONDO:0006805", "kind": "spoken", "text": "최근 가슴 통증이 점점 잦아지고 쉬어도 아프다고 해요."}
{"id": "MONDO:0019249", "kind": "everyday", "text": "뼈 모양이 변하고 키가 안 크는 희귀 유전병"}
{"id": "MONDO:0019249", "kind": "typo", "text": "뮤코다앙증"}
{"id": "MONDO:0019249", "kind": "mixed", "text": "MPS(뮤코다당증)"}
{"id": "MONDO:0019249", "kind": "spoken", "text": "아이가 간이 커지고 뼈가 변형돼서 희귀병이래요."}
{"id": "MONDO:0004608", "kind": "everyday", "text": "목 안쪽 중간 부위에 생긴 암"}
{"id": "MONDO:0004608", "kind": "typo", "text": "구인듀암"}
{"id": "MONDO:0004608", "kind": "mixed", "text": "구인두 Ca"}
{"id": "MONDO:0004608", "kind": "spoken", "text": "목구멍 안쪽 중간 부위에 암이 생겼다고 하네요."}
{"id": "MONDO:0011385", "kind": "everyday", "text": "디스크가 닳아서 쿠션이 얇아진 상태"}
{"id": "MONDO:0011385", "kind": "typo", "text": "추간판 퇴헹성 질환"}
{"id": "MONDO:0011385", "kind": "mixed", "text": "IDD 추간판 퇴행"}
{"id": "MONDO:0011385", "kind": "spoken", "text": "나이 들면서 디스크가 닳았다고 MRI에서 나왔어요."}
{"id": "MONDO:0002272", "kind": "everyday", "text": "면역 단백이 전체적으로 많이 올라갔다는 검사"}
{"id": "MONDO:0002272", "kind": "typo", "text": "다클룬 고감마글로블린혈증"}
{"id": "MONDO:0002272", "kind": "mixed", "text": "polyclonal 감마글로불린 증가"}
{"id": "MONDO:0002272", "kind": "spoken", "text": "피검사에서 면역글로불린이 전반적으로 높대요."}
{"id": "MONDO:0001195", "kind": "everyday", "text": "진드기에 물린 뒤 열나고 몸에 빨간 반점이 생긴 병"}
{"id": "MONDO:0001195", "kind": "typo", "text": "홍바열"}
{"id": "MONDO:0001195", "kind": "mixed", "text": "spotted fever(홍반열)"}
{"id": "MONDO:0001195", "kind": "spoken", "text": "진드기에 물리고 며칠 뒤 열이 나고 발진이 올라왔어요."}
{"id": "MONDO:0001243", "kind": "everyday", "text": "온몸에서 피가 멎지 않고 피떡도 생기는 상태"}
{"id": "MONDO:0001243", "kind": "typo", "text": "파종성 혈관내응구"}
{"id": "MONDO:0001243", "kind": "mixed", "text": "DIC(파종성 혈관내응고)"}
{"id": "MONDO:0001243", "kind": "spoken", "text": "여기저기서 피가 나고 응고 기능이 떨어졌다고 해요."}
{"id": "MONDO:0006664", "kind": "everyday", "text": "태어날 때부터 심장 윗방 사이에 구멍이 있는 병"}
{"id": "MONDO:0006664", "kind": "typo", "text": "심방중격걸손"}
{"id": "MONDO:0006664", "kind": "mixed", "text": "ASD(심방중격결손)"}
{"id": "MONDO:0006664", "kind": "spoken", "text": "애기 때부터 심장에 구멍이 있었는데 수술 얘기가 나왔어요."}
{"id": "MONDO:0005246", "kind": "everyday", "text": "뼈 안에 균이 들어가서 고름이 차는 병"}
{"id": "MONDO:0005246", "kind": "typo", "text": "골수엮"}
{"id": "MONDO:0005246", "kind": "mixed", "text": "osteomyelitis 골수염"}
{"id": "MONDO:0005246", "kind": "spoken", "text": "발뼈에 균이 들어가서 골수염이래요, 항생제 오래 맞아요."}
{"id": "MONDO:0017376", "kind": "everyday", "text": "장염이나 요도염 앓고 나서 관절이 붓는 것"}
{"id": "MONDO:0017376", "kind": "typo", "text": "반응선 관절염"}
{"id": "MONDO:0017376", "kind": "mixed", "text": "ReA 반응성관절염"}
{"id": "MONDO:0017376", "kind": "spoken", "text": "장염 앓고 나서부터 무릎이랑 발목이 붓고 아파요."}
{"id": "MONDO:0017775", "kind": "everyday", "text": "동남아 흙이나 물에서 옮는 세균 감염"}
{"id": "MONDO:0017775", "kind": "typo", "text": "유비져"}
{"id": "MONDO:0017775", "kind": "mixed", "text": "Melioidosis 유비저"}
{"id": "MONDO:0017775", "kind": "spoken", "text": "동남아 다녀온 뒤로 고열이 나고 기침이 심해졌어요."}
{"id": "MONDO:0011284", "kind": "everyday", "text": "눈이 찌그러져서 사물이 겹쳐 보이는 것"}
{"id": "MONDO:0011284", "kind": "typo", "text": "난씨"}
{"id": "MONDO:0011284", "kind": "mixed", "text": "난시(Astig)"}
{"id": "MONDO:0011284", "kind": "spoken", "text": "안경 바꿨는데도 글씨가 겹쳐 보인대요, 난시래요."}
{"id": "MONDO:0022208", "kind": "everyday", "text": "관절 안에 결정 같은 게 쌓여서 아픈 것"}
{"id": "MONDO:0022208", "kind": "typo", "text": "결정 관젤병증"}
{"id": "MONDO:0022208", "kind": "mixed", "text": "crystal 관절병증"}
{"id": "MONDO:0022208", "kind": "spoken", "text": "관절액 검사에서 결정이 보여서 관절병증이래요."}
{"id": "MONDO:0002008", "kind": "everyday", "text": "귀 안쪽이 부어서 빙글빙글 어지러운 병"}
{"id": "MONDO:0002008", "kind": "typo", "text": "미로엽"}
{"id": "MONDO:0002008", "kind": "mixed", "text": "labyrinthitis 미로염"}
{"id": "MONDO:0002008", "kind": "spoken", "text": "감기 후 귀 안쪽이 아프고 어지러워서 미로염이래요."}
{"id": "MONDO:0000333", "kind": "everyday", "text": "엄마한테서 태아 때 옮은 매독"}
{"id": "MONDO:0000333", "kind": "typo", "text": "조기선천 메독"}
{"id": "MONDO:0000333", "kind": "mixed", "text": "선천성 syphilis 조기"}
{"id": "MONDO:0000333", "kind": "spoken", "text": "태어난 아기가 매독이래요, 엄마한테서 옮았대요."}
{"id": "MONDO:0016047", "kind": "everyday", "text": "수술 뒤 눈 속에 세균이 들어가 곪은 것"}
{"id": "MONDO:0016047", "kind": "typo", "text": "안대염"}
{"id": "MONDO:0016047", "kind": "mixed", "text": "endophthalmitis 안내염"}
{"id": "MONDO:0016047", "kind": "spoken", "text": "백내장 수술 후 눈이 많이 붓고 고름이 나서 안내염이래요."}
{"id": "MONDO:0007606", "kind": "everyday", "text": "근육이 점점 뼈처럼 굳어가는 희귀 유전병"}
{"id": "MONDO:0007606", "kind": "typo", "text": "진행성 골화성 섬유이형성종"}
{"id": "MONDO:0007606", "kind": "mixed", "text": "FOP(진행성 골화증)"}
{"id": "MONDO:0007606", "kind": "spoken", "text": "근육이 뼈처럼 굳는 희귀병이래요, 엄지발가락이 기형이래요."}
