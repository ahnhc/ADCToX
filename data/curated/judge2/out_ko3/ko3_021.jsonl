{"id": "MONDO:0005965", "kind": "short", "text": "척추협착"}
{"id": "MONDO:0005965", "kind": "mixed", "text": "요추 spinal stenosis 진단"}
{"id": "MONDO:0010933", "kind": "abbrev", "text": "DFNB4"}
