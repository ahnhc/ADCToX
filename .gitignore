.pytest_cache/
*.log
*.pre-centering-bug

# Opus dataset review: the batch inputs (17 MB) are rebuilt by ml/dataset_review_batches.py; the verdicts in out/ are kept
data/curated/review_opus/batches/

# Teammate workbooks are never committed
*.xlsx

# Organ labels v5: batch inputs (cut from input/concepts.jsonl by ml/relabel_v5.py), Codex session event logs and the abandoned
